# Copy to .env.local and fill in. Never commit the filled version.
# See docs/03-auth-and-setup.md for where each of these comes from.

# --- app gate ---------------------------------------------------------------
# Single password protecting the whole app. This dashboard renders a real
# inbox; it must not be reachable without this.
APP_PASSWORD=

# Vercel sends this as a bearer token on scheduled cron runs.
CRON_SECRET=

# --- instagram --------------------------------------------------------------
# From your Meta developer app. The app stays in Development mode and is never
# submitted for review, because you are its only user and its admin.
IG_APP_ID=
IG_APP_SECRET=

# The Instagram Business account id, from /me/accounts -> instagram_business_account
IG_USER_ID=

# Long-lived token, 60 days. Seeded here once; after first boot the tokens
# table is the source of truth and the daily cron refreshes it.
IG_ACCESS_TOKEN=

# Optional. Graph API version; check Meta's changelog for the current one.
IG_GRAPH_VERSION=v23.0

# --- gmail ------------------------------------------------------------------
GOOGLE_EMAIL=elliotcameronbusiness@gmail.com

# A Google app password, not the account password and not OAuth.
# Requires 2-Step Verification on the account. See docs/03-auth-and-setup.md
# for why OAuth is the wrong trade here.
GOOGLE_APP_PASSWORD=

# --- drafting ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- storage ----------------------------------------------------------------
DATABASE_URL=
