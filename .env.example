# Copy this file to .env and fill in your keys. Never commit .env.

# Claude writes your on-screen captions. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Windsor.ai pulls your Instagram stats. Find it at https://onboard.windsor.ai (API key page)
WINDSOR_API_KEY=

# Meta Graph API: needed to POST trial reels and to look at competitor accounts.
# See README "Step 3: Get your Instagram posting key".
IG_USER_ID=17841400621094281
IG_ACCESS_TOKEN=

# HikerAPI: reads competitor reels (views + video) for the Competitor Radar. https://hikerapi.com
HIKER_API_KEY=

# Only if posting.backend is "metricool" (paid plan). Find these in Metricool's API settings.
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
